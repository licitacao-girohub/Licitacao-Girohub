# ===== Sistema =====
# Modo de dados: "google" (produção) ou "demo" (só na sua máquina, sem Google)
DATA_MODE=google
# Segredo das sessões (mínimo 32 caracteres). Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Usuários e senhas (gerado por: npm run senha)
AUTH_USERS_B64=

# ===== Google (conta GiroHub: licitacao@girohub.com.br) =====
GOOGLE_AUTH_MODE=oauth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Gerado por: npm run google:auth
GOOGLE_REFRESH_TOKEN=
# Gerados por: npm run google:setup
SHEET_ID=
DRIVE_ROOT_ID=
# Opcional (obrigatório só com GOOGLE_AUTH_MODE=service_account): pasta/Drive compartilhado onde criar a raiz
DRIVE_PARENT_ID=
